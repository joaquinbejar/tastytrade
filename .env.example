# TastyTrade API Configuration
# Copy this file to .env and fill in your actual credentials

# Authentication is OAuth2. Username and password login (POST /sessions) was
# decommissioned by tastytrade on 2026-02-11 and no longer works.
#
# Create an OAuth application and a personal grant on my.tastytrade.com under
# Manage > My Profile > API. The application gives you a client secret (shown
# once), and the grant gives you a refresh token (long-lived; delete the grant
# if it leaks).

# The OAuth application's client secret
TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret

# The grant's refresh token
TASTYTRADE_REFRESH_TOKEN=your_oauth_refresh_token

# Only needed for the trusted third-party authorization-code flow, where you
# authorize other people's accounts. The personal flow above ignores both.
TASTYTRADE_CLIENT_ID=
TASTYTRADE_REDIRECT_URI=

# Environment selector. Certification (sandbox) is the DEFAULT: leave this
# unset, empty or misspelled and you get the certification environment.
# Production requires an explicit `false`, and orders placed there are real.
TASTYTRADE_USE_DEMO=true

# Log level for debugging (TRACE, DEBUG, INFO, WARN, ERROR)
LOGLEVEL=INFO

# Note: When TASTYTRADE_USE_DEMO=true, the following URLs will be used automatically:
# - API Base URL: https://api.cert.tastyworks.com
# - WebSocket URL: wss://streamer.cert.tastyworks.com
#
# When TASTYTRADE_USE_DEMO=false, production URLs will be used:
# - API Base URL: https://api.tastyworks.com
# - WebSocket URL: wss://streamer.tastyworks.com

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your OAuth credentials
# 3. Set TASTYTRADE_USE_DEMO=true for sandbox testing
# 4. Run examples: cargo run -p miscellaneous --bin authenticate
